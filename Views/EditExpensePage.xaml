<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MAUIBUDGET.ViewModels"
             xmlns:controls="clr-namespace:MAUIBUDGET"
             x:Class="MAUIBUDGET.EditExpensePage"
             x:DataType="viewModels:ExpensePageViewModel"
             Title="Edit Expense">
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="15">
            <controls:ExpenseEditorView x:Name="Editor"
                                        Expense="{Binding CurrentExpense, Mode=TwoWay}"
                                        CategoryList="{Binding Categories}"
                                        SelectedCategory="{Binding SelectedCategory, Mode=TwoWay}"/>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                <Button Text="Cancel"
                        Command="{Binding CancelExpenseEditCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDarkText}}"/>
                <Button Text="Delete"
                        Command="{Binding DeleteExpenseCommand}"
                        Background="{StaticResource Tertiary}"/>
                <Button Text="Update"
                        Command="{Binding UpdateExpenseCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
